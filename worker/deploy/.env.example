# Hostname pointing at this server's public IP (an A record on your domain, a free name.duckdns.org,
# or <ip-with-dashes>.sslip.io, which needs no setup).
WORKER_DOMAIN=wa-worker.example.com

# Must equal WORKER_API_KEY on Vercel.
INTERNAL_API_KEY=change-me-to-a-long-random-string
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

GHL_CLIENT_ID=
GHL_CONVERSATION_PROVIDER_ID=
GHL_INBOUND_TYPE=Custom
# Tokens are refreshed through the web app, so GHL_CLIENT_SECRET stays on Vercel only.
TOKEN_REFRESH_URL=https://your-vercel-domain.vercel.app/api/oauth/refresh

# Optional number protection (defaults shown). See README "Admin, sub-accounts and multiple numbers".
# NEW_CHATS_PER_DAY=30
# WARMUP_DAYS=7
# WARMUP_NEW_CHATS_PER_DAY=10
# COLD_MESSAGES_PER_CONTACT=3
# FAILOVER_WAIT_SECONDS=60
# NUMBERS_PER_SUBACCOUNT=5
